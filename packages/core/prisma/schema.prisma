  deliverableId String
  frameIndex    Int      @default(0)
  platform      Platform
  compliant     Boolean
  issues        String[]
  evidenceS3Key String?
  checkedAt     DateTime @default(now())

  @@unique([deliverableId, frameIndex])
  @@map("disclosure_checks")
}

// ═════════════ Kategori taksonomisi ═════════════
/// Ana/alt kategori (admin panelinden düzenlenir). Influencer.category / Brand.category geriye
/// uyumluluk için ana kategorinin adını tutmaya devam eder.
model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  sort      Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  influencers InfluencerCategory[]
  brands      BrandCategory[]

  @@index([parentId])
}

model InfluencerCategory {
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  primary      Boolean    @default(false)

  @@id([influencerId, categoryId])
  @@index([categoryId])
}

model BrandCategory {
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  primary    Boolean  @default(false)

  @@id([brandId, categoryId])
  @@index([categoryId])
}

/// Denetim/sistem job'larının çalışma geçmişi (Agent merkezi: son çalışma, süre, sonuç).
