  MANUAL_TRACKING
}

enum ContentTriggerRule {
  AFTER_DELIVERY
  ANYTIME
}

enum ShipmentStatus {
  PENDING_ADDRESS
  READY_TO_SHIP
  LABEL_CREATED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

/// Marka kargo entegrasyon ayarları (API bilgileri AES-256-GCM ile şifreli saklanır).
model BrandShippingIntegration {
