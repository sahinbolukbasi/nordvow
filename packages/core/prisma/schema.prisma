  transferTarget    String
  contractSignedAt  DateTime
  dueAt             DateTime
  remindedAt        DateTime?
  receiptS3Key      String?
  receiptUploadedAt DateTime?
  createdAt         DateTime  @default(now())

  @@unique([tenantId, transferTarget])
  @@map("cross_border_filings")
}

model InfluencerTaxProfile {
  influencerId        String           @id @map("influencer_id")
