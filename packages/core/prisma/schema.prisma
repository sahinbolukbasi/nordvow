model Offer {
  id           String    @id @default(cuid())
  brandId      String
  influencerId String
  createdById  String
  campaignId   String?
  title        String
  message      String
  /// [{platform, contentType, qty, priceKurus}]
  items        Json
  totalKurus   Int
  publishBy    DateTime?
  /// GONDERILDI | KARSI_TEKLIF | KABUL | RED | GERI_CEKILDI | SURESI_DOLDU | KAMPANYAYA_EKLENDI
