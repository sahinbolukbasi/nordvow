  offerId      String?                   @map("offer_id")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  @@unique([openCallId, influencerId])
  @@index([influencerId, status])
  @@map("campaign_applications")
}

// ============================================================================
// Çok kanallı bildirim sistemi (sistem içi + e-posta + WhatsApp + Instagram)
// + link kısaltma/tıklama ölçümü. Kanallar anahtar gelene kadar mock modda çalışır.
// ============================================================================

enum NotifChannel {
  INAPP
  EMAIL
  WHATSAPP
  INSTAGRAM
}

enum NotifDeliveryStatus {
  QUEUED
  SENT
  MOCKED
  FAILED
  SKIPPED
}

/// Bir olay için kanal bazlı kural: hangi olay hangi kanallardan gönderilsin.
model NotificationRule {
  id        String         @id @default(cuid())
  eventKey  String         @unique @map("event_key")
  channels  NotifChannel[]
  enabled   Boolean        @default(true)
  updatedAt DateTime       @updatedAt @map("updated_at")
  @@map("notification_rules")
}

/// Olay + kanal başına metin şablonu (yer tutucular: {{ad}}, {{baslik}} vb.).
model NotificationTemplate {
  id        String       @id @default(cuid())
  eventKey  String       @map("event_key")
  channel   NotifChannel
  subject   String?
  body      String
  updatedAt DateTime     @updatedAt @map("updated_at")
  @@unique([eventKey, channel])
  @@map("notification_templates")
}

/// Gönderim kaydı (denetim + mock görünürlüğü).
model NotificationLog {
  id         String              @id @default(cuid())
  eventKey   String              @map("event_key")
  channel    NotifChannel
  userId     String?             @map("user_id")
  toAddress  String?             @map("to_address")
  subject    String?
  body       String
  status     NotifDeliveryStatus @default(QUEUED)
  error      String?
  createdAt  DateTime            @default(now()) @map("created_at")
  @@index([eventKey, createdAt])
  @@index([userId])
  @@map("notification_logs")
}

/// Kısa link + tıklama sayacı.
model ShortLink {
  id         String    @id @default(cuid())
  slug       String    @unique
  targetUrl  String    @map("target_url")
  label      String?
  clicks     Int       @default(0)
  createdByUserId String? @map("created_by_user_id")
  lastClickAt DateTime? @map("last_click_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  @@map("short_links")
}

/// Kullanıcı destek talebi (hata bildirimi, soru, istek). Admin gelen kutusunda yönetilir.
model SupportTicket {
  id         String              @id @default(cuid())
  userId     String?             @map("user_id")
  role       String?
  name       String
  email      String
  category   SupportCategory     @default(SORU)
  subject    String
  message    String
  pageUrl    String?             @map("page_url")
  status     SupportStatus       @default(ACIK)
  adminNote  String?             @map("admin_note")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  @@index([status, createdAt])
  @@index([userId])
  @@map("support_tickets")
}

enum SupportCategory {
  HATA
  SORU
  ISTEK
  DIGER
}

enum SupportStatus {
  ACIK
  INCELEMEDE
  COZULDU
  KAPANDI
}

/// Rol veya kişi bazlı sayfa görünürlüğü. Yalnız DARALTIR: koddaki rol kuralları üstte kalır.
/// scopeType=ROLE ise scopeId bir Role değeri; scopeType=USER ise scopeId bir user id.
/// allowed=false bir yolu gizler/engeller; allowed=true bir kişiye özel istisnayı geri açar.
model PagePermission {
  id         String   @id @default(cuid())
  scopeType  String   @map("scope_type")
  scopeId    String   @map("scope_id")
  pathPrefix String   @map("path_prefix")
  allowed    Boolean  @default(false)
  updatedByUserId String? @map("updated_by_user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  @@unique([scopeType, scopeId, pathPrefix])
  @@index([scopeType, scopeId])
  @@map("page_permissions")
}

/// Creative bakiye (kredi) yükleme talebi. Kullanıcı talep eder, yönetici onaylayınca bakiye yüklenir.
model CreditRequest {
  id          String              @id @default(cuid())
  tenantId    String              @map("tenant_id")
  requestedByUserId String?       @map("requested_by_user_id")
  role        String?
  amountTry   Int                 @map("amount_try")
  note        String?
  status      CreditRequestStatus @default(BEKLIYOR)
  decidedByUserId String?         @map("decided_by_user_id")
  decidedAt   DateTime?           @map("decided_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  @@index([status, createdAt])
  @@index([tenantId])
  @@map("credit_requests")
}

enum CreditRequestStatus {
  BEKLIYOR
  ONAYLANDI
  RED
}

/// Creative stüdyosuna kullanıcının yüklediği veya stüdyoda düzenlediği görsel/video.
/// AI üretimi değildir (AI çıktıları generated_assets'te, C2PA etiketli).
model CreativeUpload {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  uploadedByUserId String?  @map("uploaded_by_user_id")
  kind             String
  mime             String
  sizeBytes        Int      @map("size_bytes")
  s3Key            String   @map("s3_key")
  name             String?
  /// upload: kullanıcı yükledi · edit: stüdyo düzenleyicisiyle türetildi
  source           String   @default("upload")
  parentId         String?  @map("parent_id")
  durationSec      Float?   @map("duration_sec")
  createdAt        DateTime @default(now()) @map("created_at")
  @@index([tenantId, createdAt])
  @@map("creative_uploads")
}

/// Video düzenleme işi (ffmpeg, sunucuda; AI maliyeti yok). Kuyruk sırayla işlenir.
model VideoEditJob {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  uploadId       String   @map("upload_id")
  ops            Json
  status         String   @default("QUEUED")
  outputUploadId String?  @map("output_upload_id")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@index([status, createdAt])
  @@index([tenantId, createdAt])
  @@map("video_edit_jobs")
}

/// Bakiye hareketleri (TL). Her yükleme, hoş geldin bakiyesi ve tahsilat tek satır; değiştirilmez.
/// Kullanıcıya "bakiyem neden azaldı" sorusunun cevabı ve muhasebe izi.
model CreditLedger {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  /// STARTER · TOPUP · CHARGE · REFUND · ADJUST
  kind         String
  /// + yükleme, − tahsilat (TL)
  amount       Decimal  @db.Decimal(14, 3)
  balanceAfter Decimal  @map("balance_after") @db.Decimal(14, 3)
  jobId        String?  @map("job_id")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")
  @@index([tenantId, createdAt])
  @@map("credit_ledger")
}

// ───────────── NORDVOW CREATIVE AI KATMANI ─────────────

enum OrgType {
  AGENCY
  BRAND
  INFLUENCER_STUDIO
  ENTERPRISE
}

enum MediaCapability {
  IMAGE_GENERATION
  IMAGE_EDIT
  VIDEO_GENERATION
  VIDEO_EDIT
  TTS
  LIP_SYNC
  AVATAR
  UPSCALE
  REMOVE_BACKGROUND
}

enum MediaJobStatus {
  PENDING_RESERVATION
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BiometricConsentType {
  VOICE_CLONING
  AVATAR_LIPSYNC
  DIGITAL_TWIN
  IMAGE_RIGHTS
}

enum LegalConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

/// Organizasyon & White-Label & Çoklu Kiracılık Modeli
model Organization {
  id                     String                  @id @default(cuid())
  name                   String
  type                   OrgType                 @default(BRAND)
  tier                   String                  @default("standard")
  whiteLabelEnabled      Boolean                 @default(false) @map("white_label_enabled")
  whiteLabelConfig       Json?                   @map("white_label_config") // { logoUrl, brandColor, customDomain, companyName }
  creditMarginMultiplier Decimal                 @default(1.0) @map("credit_margin_multiplier") @db.Decimal(5, 3) // Agency wholesale indirim/marj katsayısı
  maxConcurrentJobs      Int                     @default(5) @map("max_concurrent_jobs")
  monthlyBudgetCapUsd    Decimal?                @map("monthly_budget_cap_usd") @db.Decimal(12, 2)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  users                  User[]
  mediaJobs              MediaJob[]
  legalConsents          BiometricLegalConsent[]

  @@map("organizations")
}

/// Biyometrik ve Hukuki Rıza Kayıtları (KVKK / GDPR Uyum Katmanı)
model BiometricLegalConsent {
  id                String               @id @default(cuid())
  userId            String               @map("user_id")
  organizationId    String?              @map("organization_id")
  consentType       BiometricConsentType @map("consent_type")
  legalTextVersion  String               @map("legal_text_version")
  legalTextHash     String               @map("legal_text_hash")
  ipAddress         String               @map("ip_address")
  userAgent         String               @map("user_agent")
  signatureEvidence String?              @map("signature_evidence")
  status            LegalConsentStatus   @default(ACTIVE)
  consentedAt       DateTime             @default(now()) @map("consented_at")
  expiresAt         DateTime?            @map("expires_at")
  revokedAt         DateTime?            @map("revoked_at")

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  mediaJobs         MediaJob[]

  @@index([userId, consentType, status])
  @@map("biometric_legal_consents")
}

/// AI Sağlayıcı Sağlık ve Dinamik Durum Tablosu
model MediaProvider {
  id              String             @id // "fal", "google", "byteplus", "minimax", "elevenlabs", "kling", "heygen", "recraft", "ideogram", "replicate"
  name            String
  description     String?
  isEnabled       Boolean            @default(true) @map("is_enabled")
  healthScore     Decimal            @default(100.0) @map("health_score") @db.Decimal(5, 2)
  errorRate       Decimal            @default(0.0) @map("error_rate") @db.Decimal(5, 4)
  avgLatencyMs    Int                @default(500) @map("avg_latency_ms")
  rateLimitPerMin Int?               @map("rate_limit_per_min")
  lastCheckedAt   DateTime           @default(now()) @map("last_checked_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  primaryModels   MediaModelConfig[] @relation("PrimaryProvider")
  fallbackModels  MediaModelConfig[] @relation("FallbackProvider")

  @@map("media_providers")
}

/// Dinamik Model Maliyet, Yönlendirme ve Kredi Fiyatlandırma Tablosu
model MediaModelConfig {
  alias                String          @id // "draft-image", "mid-image", "pro-image", "vector-image", "draft-video", "mid-video", "pro-video", "lip-sync", "avatar", "fast-tts", "music-gen"
  capability           MediaCapability
  displayName          String          @map("display_name")
  primaryProviderId    String          @map("primary_provider_id")
  primaryModelId       String          @map("primary_model_id")
  fallbackProviderId   String?         @map("fallback_provider_id")
  fallbackModelId      String?         @map("fallback_model_id")
  officialCostUsd      Decimal         @map("official_cost_usd") @db.Decimal(10, 6)
  loadedMultiplier     Decimal         @default(1.15) @map("loaded_multiplier") @db.Decimal(4, 2)
  retailMultiplier     Decimal         @default(3.00) @map("retail_multiplier") @db.Decimal(4, 2)
  creditPrice          Decimal         @map("credit_price") @db.Decimal(10, 3)
  unitType             String          @map("unit_type") // "image", "second", "1000_chars", "minute"
  minRole              Role            @default(INFLUENCER) @map("min_role")
  isDraftFirstRequired Boolean         @default(false) @map("is_draft_first_required")
  isBatchSupported     Boolean         @default(false) @map("is_batch_supported")
  isActive             Boolean         @default(true) @map("is_active")
  featureFlag          String?         @map("feature_flag")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  primaryProvider      MediaProvider   @relation("PrimaryProvider", fields: [primaryProviderId], references: [id])
  fallbackProvider     MediaProvider?  @relation("FallbackProvider", fields: [fallbackProviderId], references: [id])
  mediaJobs            MediaJob[]

  @@map("media_model_configs")
}

/// Asenkron Medya Üretim ve Yönlendirme İş Kaydı
model MediaJob {
  id                String                 @id @default(cuid())
  organizationId    String?                @map("organization_id")
  userId            String                 @map("user_id")
  alias             String
  capability        MediaCapability
  prompt            String
  negativePrompt    String?                @map("negative_prompt")
  promptHash        String                 @map("prompt_hash")
  parameters        Json
  status            MediaJobStatus         @default(PENDING_RESERVATION)
  providerUsed      String?                @map("provider_used")
  modelUsed         String?                @map("model_used")
  fallbackTriggered Boolean                @default(false) @map("fallback_triggered")
