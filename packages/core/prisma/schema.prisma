  tenantId       String
  adSetId        String
  newBudgetMinor Int
  requestedAt    DateTime  @default(now())
  scheduledFor   DateTime
  appliedAt      DateTime?
  status         String    @default("queued")
  reason         String?

  @@index([adSetId, appliedAt])
  @@map("ad_budget_changes")
}

model PartnershipAdCode {
  id             String    @id @default(cuid())
  tenantId       String
  influencerId   String
  igMediaId      String
  adCode         String?
  state          String    @default("requested")
  lastVerifiedAt DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@unique([tenantId, igMediaId])
  @@map("partnership_ad_codes")
}

model ModelRegistry {
  key            String        @id
  provider       String
  modelId        String        @map("model_id")
  kind           String
  unit           String
  unitPriceUsd   Decimal       @map("unit_price_usd") @db.Decimal(12, 6)
  creditsPerUnit Decimal       @map("credits_per_unit") @db.Decimal(10, 3)
  deterministic  Boolean       @default(true)
  maxUnits       Int?
  status         ModelStatus   @default(active)
  deprecatedAt   DateTime?     @map("deprecated_at")
  replacementKey String?       @map("replacement_key")
  licenseStatus  LicenseStatus @default(pending) @map("license_status")
  emitsC2pa      Boolean?      @map("emits_c2pa")
  featureFlag    String?
  priceVerified  Boolean       @default(false)

  @@map("model_registry")
}

model CreditAccount {
  tenantId        String   @id
  /// Hesabın para birimi (Creative bakiyesi bu birimde).
  currency        String   @default("TRY")
  balanceCredits  Decimal  @default(0) @db.Decimal(14, 3)
  heldCredits     Decimal  @default(0) @db.Decimal(14, 3)
  lowBalanceAlert Decimal  @default(100) @db.Decimal(14, 3)
  updatedAt       DateTime @updatedAt

  @@map("credit_accounts")
}

model CreditHold {
  id        String    @id @default(cuid())
  tenantId  String
  credits   Decimal   @db.Decimal(14, 3)
  status    String    @default("held")
  settledAt DateTime?
  createdAt DateTime  @default(now())

  @@map("credit_holds")
}

model CreativeJob {
  id           String            @id @default(cuid())
  tenantId     String
  campaignId   String?
  modelKey     String
  modelId      String
  prompt       String
  promptHash   String
  units        Decimal           @db.Decimal(10, 3)
  requestId    String?           @unique
  creditHoldId String?
  /// Düzenleme işlerinde kaynak dosya (kullanıcı yüklemesi); üretimde null.
  inputUploadId String?          @map("input_upload_id")
  /// Çok adımlı AI düzenleme: bu iş bitince sırayla çalışacak kalan adımlar ve zincirin ilk işi.
  pipeline     Json?
