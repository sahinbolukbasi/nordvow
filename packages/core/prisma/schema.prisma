  trigger    String    @default("schedule")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  created    Int       @default(0)
  skipped    Int       @default(0)
  ok         Boolean   @default(true)
  error      String?

  @@index([job, startedAt])
}

// ═════════════ Davetle kayıt ═════════════
/// Davet kodu: admin (influencer veya marka için) ya da influencer (yalnız influencer için) üretir.
model Invite {
  id                  String    @id @default(cuid())
  code                String    @unique
  targetRole          Role
  createdById         String
  createdBy           User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  inviterInfluencerId String?
  maxUses             Int       @default(1)
  uses                Int       @default(0)
  expiresAt           DateTime
  note                String?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())

  applications SignupApplication[]

  @@index([createdById])
}

/// Kayıt başvurusu: onaylanınca influencer/marka profili oluşturulur ve kullanıcı ACTIVE olur.
model SignupApplication {
  id           String            @id @default(cuid())
  userId       String            @unique
  user         User              @relation("ApplicationUser", fields: [userId], references: [id], onDelete: Cascade)
  inviteId     String
  invite       Invite            @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  targetRole   Role
  data         Json
  status       ApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime          @default(now())

  @@index([status, createdAt])
}

// ═════════════ Takip agent'ları (şablondan, kampanya/influencer/marka takibi) ═════════════
model TrackerAgent {
  id               String    @id @default(cuid())
  name             String
  /// campaign | story | influencer | brand (core/src/agents/trackers.ts)
  template         String
  /// CAMPAIGN | INFLUENCER | BRAND
  scope            String
  targetId         String
  /// Şablona özgü eşikler (zod ile doğrulanır)
  settings         Json      @default("{}")
  notifyAdmins     Boolean   @default(true)
  notifyBrand      Boolean   @default(false)
  notifyInfluencer Boolean   @default(false)
  enabled          Boolean   @default(true)
  createdById      String?
  lastRunAt        DateTime?
  /// [{key, severity, title, detail, href}] — son çalışmanın bulguları
  lastFindings     Json      @default("[]")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  @@index([scope, targetId])
  @@index([enabled])
  @@map("tracker_agents")
}

// ═════════════ Fiyat listesi ve teklifler (marka → içerik üreticisi) ═════════════
model RateCard {
