# Kopyala: cp .env.example .env  (yalnızca yerel geliştirme değerleri; .env gitignore'dadır)

# Postgres (docker-compose)
POSTGRES_USER=infulancer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=infulancer
DATABASE_URL=postgresql://infulancer:change-me@localhost:5432/infulancer
AUDIT_DATABASE_URL=postgresql://infulancer:change-me@localhost:5432/infulancer_audit

# Auth.js
AUTH_SECRET=change-me-generate-with-openssl
AUTH_TRUST_HOST=true

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=infulancer-assets
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me-min-8-chars
S3_FORCE_PATH_STYLE=true
PRESIGN_TTL_SECONDS=900

# Creative fal (mock | http). http için FAL_KEY gerekir.
FAL_MODE=mock
FAL_KEY=

# Kısa link izin listesi (virgülle). nordvow.com ve APP_URL hostu zaten izinlidir.
SHORTLINK_ALLOWLIST=

# E-posta bildirimleri (taşıyıcı bağlanana kadar SENT yazılmaz)
EMAIL_PROVIDER=mock
EMAIL_FROM=

# Platform botu (Nordvow kendi numarası / Instagram / sayfa). /admin/bot ile de açılır.
NORDVOW_WA_PHONE_NUMBER_ID=
NORDVOW_IG_USER_ID=
NORDVOW_PAGE_ID=

# Meta mesajlaşma (META_API_MODE=http iken)
META_API_MODE=mock
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=

# LLM (mock | bedrock)
LLM_PROVIDER=mock
BEDROCK_REGION=eu-central-1
BEDROCK_VISION_MODEL_ID=
BEDROCK_TEXT_MODEL_ID=

# Olaylar (inline | sqs)
EVENT_MODE=inline
AGENT_QUEUE_URL=

# Link kontrolü (mock | http)
LINK_CHECK_MODE=mock

# Finans
HOLD_DAYS=0
MIN_PAYOUT_KURUS=50000
# Banka talimat dosyasındaki borçlu (ajans) hesabı — pain.001 XML
AGENCY_NAME=Infulancer Ajans
AGENCY_IBAN=TR000000000000000000000000
AGENCY_BIC=NOTPROVIDED

APP_URL=http://localhost:3000
# Sosyal hesap senkronu (off | mock | http). META_API_MODE bunu açmaz; o yalnız mesajlaşma istemcisidir.
# Business Discovery Sayfa token'ı (süresiz, AWS integrations sırrında üç ad da AYNI değeri taşır):
#   Öncelik: META_SYSTEM_USER_TOKEN, sonra IG_GRAPH_TOKEN, sonra INSTAGRAM_ACCESS_TOKEN (yukarıda).
#   Kod ilk dolu olanı kullanır. Değerler farklıysa yalnız MISMATCH loglanır; değer yazılmaz.
#   Eksik anahtar ECS görevini düşürür: META_SYSTEM_USER_TOKEN, IG_GRAPH_TOKEN, INSTAGRAM_ACCESS_TOKEN, INSTAGRAM_IG_USER_ID
#   IG kullanıcı kimliği: INSTAGRAM_IG_USER_ID. Eski IG_BUSINESS_ACCOUNT_ID yalnız yerel yedek, ECS listesinde yok.
# Instagram API with Instagram Login (kişisel / gizli / kısıtlı; BD zorlanmaz, public yol OAuth ister):
#   META_APP_ID + META_APP_SECRET (yedek: INSTAGRAM_APP_ID + INSTAGRAM_APP_SECRET)
#   Yönlendirme: {APP_URL}/api/instagram/oauth/callback
#   İzin: instagram_business_basic
#   İsteğe bağlı: instagram_business_manage_insights (yoksa beğeni boş kalabilir, profil yine okunur)
#   Uygulama Unpublished ve izinler Ready for testing iken yalnız uygulama rolü olan kullanıcı bağlanabilir.
#   Kod 10/200 MISSING_PERMISSION, 110/2207013 TARGET_NOT_DISCOVERABLE olarak raporlanır.
# YouTube Data API v3; TikTok Login Kit (influencer kendi hesabını bağlar)
SOCIAL_SYNC_MODE=mock
META_SYSTEM_USER_TOKEN=
IG_GRAPH_TOKEN=
META_IG_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_PUBLIC_FALLBACK_URL=
INSTAGRAM_PUBLIC_FALLBACK_API_KEY=
AGENTCORE_RUNTIME_ARN=
AGENTCORE_REGION=eu-central-1
YOUTUBE_API_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://nordvow.com/auth/tiktok/callback
# 32-byte AES-256-GCM anahtarı (hex 64 karakter veya base64/utf8 32 byte): openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Uygulama TikTok denetiminden geçtiyse true (aksi halde yayınlar yalnız SELF_ONLY olur)
TIKTOK_APP_AUDITED=false

# Sesli Asistan Mikroservisi (NordVow Admin Panel Proxy)
VOICE_ASSISTANT_URL=http://127.0.0.1:4100

# Navlungo Domestic v2.1 Kargo Entegrasyonu
NAVLUNGO_API_URL=https://domestic-api-qa.navlungo.com/v2
NAVLUNGO_API_V21_URL=https://domestic-api-qa.navlungo.com/v2.1
NAVLUNGO_USERNAME=
NAVLUNGO_PASSWORD=
NAVLUNGO_SENDER_ADDRESS_ID=56319

# Cüzdan. Boşsa "Cüzdana ekle" web bilet/kupon sayfasına gider.
# Apple canlı sayılması için CERT, WWDR, TEAM_ID ve PASS_TYPE_ID birlikte dolu olmalı;
# aksi halde arayüz canlı görünüp istek 307 ile web sayfasına düşer.
# APPLE_WALLET_CERT — Pass Type ID sertifikası ve özel anahtarı (.p12), base64 (openssl base64 -A -in pass.p12)
# APPLE_WALLET_CERT_PASSWORD — .p12 parolası; parolasız dosyada boş bırakılır
# APPLE_WALLET_WWDR — Apple WWDR ara sertifikası (.pem veya .cer), base64
# APPLE_WALLET_TEAM_ID — Apple Developer Team ID (10 karakter)
# APPLE_WALLET_PASS_TYPE_ID — Pass Type Identifier (ör. pass.com.nordvow)
# GOOGLE_WALLET_ISSUER_ID — Wallet Business Console issuer numarası
# GOOGLE_WALLET_SA_KEY — Wallet yetkili servis hesabı JSON anahtarının tamamı, tek satır
APPLE_WALLET_CERT=
APPLE_WALLET_CERT_PASSWORD=
APPLE_WALLET_WWDR=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_PASS_TYPE_ID=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_KEY=
