  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@unique([collaborationId])
  @@index([campaignId, status])
  @@index([brandId, status])
  @@index([influencerId, status])
  @@index([trackingNumber])
  @@map("shipments")
}

// ───────────── TikTok Login Kit & Content Posting API ─────────────

enum TikTokAccountStatus {
  active
  revoked
  error
}

enum TikTokPostSource {
  FILE_UPLOAD
  PULL_FROM_URL
}

enum TikTokPostStatus {
  PROCESSING_UPLOAD
  PROCESSING_DOWNLOAD
  SEND_TO_USER_INBOX
  PUBLISH_COMPLETE
  FAILED
}

/// TikTok Login Kit v2 ile bağlanan creator hesabı; token'lar AES-256-GCM şifreli saklanır.
model TikTokAccount {
  id               String              @id @default(cuid())
  influencerId     String              @map("nordvow_user_id")
  influencer       Influencer          @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  openId           String              @unique @map("open_id")
  unionId          String?             @map("union_id")
  displayName      String?             @map("display_name")
  username         String?
  avatarUrl        String?             @map("avatar_url")
  bio              String?
  profileDeepLink  String?             @map("profile_deep_link")
  isVerified       Boolean             @default(false) @map("is_verified")
  followerCount    Int                 @default(0) @map("follower_count")
  followingCount   Int                 @default(0) @map("following_count")
  likesCount       Int                 @default(0) @map("likes_count")
  videoCount       Int                 @default(0) @map("video_count")
  /// AES-256-GCM şifreli access_token
  accessToken      String              @map("access_token")
  /// AES-256-GCM şifreli refresh_token
  refreshToken     String              @map("refresh_token")
  accessExpiresAt  DateTime            @map("access_expires_at")
  refreshExpiresAt DateTime            @map("refresh_expires_at")
  scopes           String[]            @default([])
  connectedAt      DateTime            @default(now()) @map("connected_at")
  lastSyncedAt     DateTime?           @map("last_synced_at")
  status           TikTokAccountStatus @default(active)
  lastError        String?             @map("last_error")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  videos     TikTokVideo[]
  dailyStats TikTokAccountStatsDaily[]
  posts      TikTokPost[]

  @@index([influencerId, status])
  @@index([accessExpiresAt, status])
  @@map("tiktok_accounts")
}

/// TikTok Display / Video List API'den senkronlanan videolar.
model TikTokVideo {
  id               String        @id
  accountId        String        @map("account_id")
  account          TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title            String?
  videoDescription String?       @map("video_description")
  createTime       DateTime      @map("create_time")
  coverImageUrl    String?       @map("cover_image_url")
  shareUrl         String?       @map("share_url")
  embedLink        String?       @map("embed_link")
  duration         Int?
  width            Int?
  height           Int?
  viewCount        Int           @default(0) @map("view_count")
  likeCount        Int           @default(0) @map("like_count")
  commentCount     Int           @default(0) @map("comment_count")
  shareCount       Int           @default(0) @map("share_count")
  lastSyncedAt     DateTime      @default(now()) @map("last_synced_at")

  dailyStats TikTokVideoStatsDaily[]

  @@index([accountId, createTime])
  @@map("tiktok_videos")
}

/// Günlük video performans snapshot'ları (grafikler ve trend analizi).
model TikTokVideoStatsDaily {
  id           String      @id @default(cuid())
  videoId      String      @map("video_id")
  video        TikTokVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  date         DateTime    @db.Date
  viewCount    Int         @default(0) @map("view_count")
  likeCount    Int         @default(0) @map("like_count")
  commentCount Int         @default(0) @map("comment_count")
  shareCount   Int         @default(0) @map("share_count")

  @@unique([videoId, date])
  @@index([date])
  @@map("tiktok_video_stats_daily")
}

/// Günlük hesap büyüme snapshot'ları.
model TikTokAccountStatsDaily {
  id            String        @id @default(cuid())
  accountId     String        @map("account_id")
  account       TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date          DateTime      @db.Date
  followerCount Int           @default(0) @map("follower_count")
  likesCount    Int           @default(0) @map("likes_count")
  videoCount    Int           @default(0) @map("video_count")

  @@unique([accountId, date])
  @@index([date])
  @@map("tiktok_account_stats_daily")
}

/// Nordvow'dan TikTok Content Posting API ile yayınlanan veya inbox'a gönderilen içerikler.
model TikTokPost {
  id                 String           @id @default(cuid())
  accountId          String           @map("account_id")
  account            TikTokAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignId         String?          @map("campaign_id")
  campaign           Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  deliverableId      String?          @map("deliverable_id")
  publishId          String           @unique @map("publish_id")
  source             TikTokPostSource
  mode               String           @default("DIRECT")
  privacyLevel       String           @map("privacy_level")
  caption            String?
  brandContentToggle Boolean          @default(false) @map("brand_content_toggle")
  brandOrganicToggle Boolean          @default(false) @map("brand_organic_toggle")
  disableDuet        Boolean          @default(false) @map("disable_duet")
  disableComment     Boolean          @default(false) @map("disable_comment")
  disableStitch      Boolean          @default(false) @map("disable_stitch")
  status             TikTokPostStatus @default(PROCESSING_UPLOAD)
  failReason         String?          @map("fail_reason")
  publishedVideoId   String?          @map("published_video_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([accountId, createdAt])
  @@index([campaignId])
  @@index([status])
  @@map("tiktok_posts")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum BlogAudience {
  ALL
  INFLUENCER
  BRAND
}

/// SEO destekli blog yazıları ve okunma istatistikleri.
model BlogPost {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  excerpt          String
  content          String
  coverImageUrl    String?      @map("cover_image_url")
  category         String       @default("Influencer Pazarlama")
  tags             String[]     @default([])
  targetAudience   BlogAudience @default(ALL) @map("target_audience")
  status           BlogStatus   @default(DRAFT)
  seoTitle         String?      @map("seo_title")
  seoDescription   String?      @map("seo_description")
  seoKeywords      String[]     @default([]) @map("seo_keywords")
  authorName       String       @default("Nordvow Editör") @map("author_name")
  readingTimeMin   Int          @default(3) @map("reading_time_min")
  viewCount        Int          @default(0) @map("view_count")
  readCount        Int          @default(0) @map("read_count")
  totalReadSeconds Int          @default(0) @map("total_read_seconds")
  lastReadAt       DateTime?    @map("last_read_at")
