  tenantId       String
  campaignId     String?  @map("campaign_id")
  jobId          String?
  modelKey       String   @map("model_key")
  modelId        String   @map("model_id")
  promptHash     String   @map("prompt_hash")
  parentAssetId  String?  @map("parent_asset_id")
  s3Key          String
  c2paManifestId String   @map("c2pa_manifest_id")
  isAiGenerated  Boolean  @default(true) @map("is_ai_generated")
  createdAt      DateTime @default(now()) @map("created_at")

