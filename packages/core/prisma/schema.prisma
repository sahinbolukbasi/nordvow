  platformMarkupUsd Decimal         @map("platform_markup_usd") @db.Decimal(10, 5)
  freeTierConsumed  Boolean         @map("free_tier_consumed")
  inFepWindow       Boolean         @default(false)
  billedAt          DateTime        @default(now()) @map("billed_at")

  @@unique([tenantId, messageId])
  @@index([phoneNumberId, billedAt])
