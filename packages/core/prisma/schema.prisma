  adminUnlockedById   String?
  verifiedAt          DateTime?        @map("verified_at")
  verifiedBy          String?          @map("verified_by")
  updatedAt           DateTime         @updatedAt

  @@map("influencer_tax_profile")
}

model MessageCostLedger {
